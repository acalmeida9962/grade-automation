# Python virtual environment (rebuilt per machine via setup)
.venv/
__pycache__/
*.pyc

# Browser profiles / login sessions (machine-specific, may contain cookies)
user-data/
user-data-chrome/
user-data-chromium/
user-data-edge/

# Inspection dumps
artifacts/

# Per-machine preferences (last Excel/sheet used, etc.)
settings.json

# The teacher's Excel files (real student data) live here — never commit them.
excels/
*.xlsx
*.xlsm
*.xls

# OS cruft
.DS_Store
Thumbs.db
